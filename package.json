    "console-table-printer": "^2.11.1",
    "cross-fetch": "^3.1.6",
    "danfojs-node": "^1.1.2",
    "dotenv": "^16.1.3",
    "json2csv": "^6.0.0-alpha.2",
    "onnxruntime-node": "^1.15.0",
    "tablemark": "^3.0.0",
    "tsup": "^6.7.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.2",
